# Copy to .env and fill in. Never commit .env.
# OpenAI: extraction (two calls per product) and the text-only check pass.
OPENAI_API_KEY=
# Apify: amazon.in pulls via the junglee/amazon-crawler actor.
APIFY_TOKEN=
# Optional overrides (defaults live in config/rules.js).
# CATALOG_MODEL=gpt-6-luna
# CATALOG_DATA_DIR=./data
# Import targets (stages/import.js). Deliberately not a bare DATABASE_URL: see docs/SCHEMA.md.
DATABASE_URL_DEV=
DATABASE_URL_PROD=
